      "checkConstraints": {
        "homeowner_assessments_status_ck": {
          "name": "homeowner_assessments_status_ck",
          "value": "\"homeowner_assessments\".\"status\" in ('new_enquiry', 'archived')"
        },
        "homeowner_assessments_timing_ck": {
          "name": "homeowner_assessments_timing_ck",
          "value": "\"homeowner_assessments\".\"desired_timing\" in ('asap', '3_months', '6_months', '12_months', 'other')"
        },
        "homeowner_assessments_visitor_type_ck": {
          "name": "homeowner_assessments_visitor_type_ck",
          "value": "\"homeowner_assessments\".\"visitor_type\" in ('homeowner', 'pool_builder', 'other')"
        },
        "homeowner_assessments_other_detail_ck": {
          "name": "homeowner_assessments_other_detail_ck",
          "value": "(\"homeowner_assessments\".\"visitor_type\" <> 'other' or length(trim(coalesce(\"homeowner_assessments\".\"visitor_type_other_detail\", ''))) > 0) and (\"homeowner_assessments\".\"desired_timing\" <> 'other' or length(trim(coalesce(\"homeowner_assessments\".\"desired_timing_other_detail\", ''))) > 0)"
        },
        "homeowner_assessments_consent_ck": {
          "name": "homeowner_assessments_consent_ck",
          "value": "\"homeowner_assessments\".\"consent_given\" = true"
        },
        "homeowner_assessments_feasibility_ck": {
          "name": "homeowner_assessments_feasibility_ck",
          "value": "\"homeowner_assessments\".\"feasibility_state\" in ('no_warning', 'needs_checking', 'blocked')"
        },
        "homeowner_assessments_delivery_ck": {
          "name": "homeowner_assessments_delivery_ck",
          "value": "\"homeowner_assessments\".\"email_delivery_state\" in ('pending', 'sending', 'sent', 'failed') and \"homeowner_assessments\".\"forwarding_state\" in ('pending', 'sending', 'sent', 'failed')"
        },
        "homeowner_assessments_delivery_attempts_ck": {
          "name": "homeowner_assessments_delivery_attempts_ck",
          "value": "\"homeowner_assessments\".\"email_delivery_attempt_count\" >= 0 and \"homeowner_assessments\".\"forwarding_attempt_count\" >= 0"
        }
      },
