# Application
APP_BASE_URL=http://localhost:3000
ANALYSIS_VERSION=poc-v1
LOG_LEVEL=info
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RETRY_COUNT=2

# Test deployments remain noindex unless this is explicitly enabled for the final public hostname
SITE_INDEXING_ENABLED=false

# Optional GA4 measurement; the script still waits for explicit analytics consent
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Signed Property Check snapshots (server only). Saved-report access tokens use
# this when set, otherwise derive a separate key from RESEND_API_KEY.
INTERNAL_REPORT_SIGNING_SECRET=

# Legacy internal diagnostics only; not used by the public or Admin journeys
INTERNAL_ACCESS_USERNAME=
INTERNAL_ACCESS_PASSWORD=

# PostgreSQL / Neon (server only)
DATABASE_URL=
# Optional dedicated database used only by Vercel Preview deployments.
DATABASE_URL_DEV=

# Official GIS providers (server only; provision only after Stage 2 confirms use)
LINZ_DATA_SERVICE_API_KEY=
LINZ_BASEMAPS_API_KEY=
AUCKLAND_COUNCIL_API_KEY=

# Public rate limiting (required for every production/preview deployment)
# Local `next dev` uses an enforcing in-memory fallback when these are empty.
# Production fails closed; never deploy public routes without both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable PDF storage (optional until selected)
BLOB_READ_WRITE_TOKEN=

# Preliminary report delivery (server only)
RESEND_API_KEY=
REPORT_FROM_EMAIL=
# synthetic_test enables ADR-0005 only in local development/test or Vercel Preview.
# production_test exercises recipient confirmation only in Vercel Preview and sends
# only to the submitted test recipient. production is Vercel Production only.
# Both modes never send to the internal test mailbox.
REPORT_DELIVERY_MODE=synthetic_test
# Preview-only opt-in for a single real-recipient verification test. Never set in Production.
PREVIEW_REPORT_DELIVERY_TEST=
# Preview-only sender override. Use a mailbox on a Resend-verified domain.
PREVIEW_REPORT_FROM_EMAIL=
# Keep unset until docs/privacy-request-handling.md records a passing ServiceM8 retention gate.
SERVICEM8_FORWARD_EMAIL=

# Scheduled report-request retention (server only, 16+ random characters)
CRON_SECRET=

# Optional narrative generation; deterministic reporting remains the default
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
